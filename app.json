{
  "expo": {
    "name": "Agente Financeiro",
    "slug": "tsk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tsk",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.teskegui.agentetsk"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita o microfone para registrar gastos por voz.",
          "speechRecognitionPermission": "Permita reconhecer sua fala para ativar o Agente e registrar gastos."
        }
      ],
      "./plugins/with-tsk-siri",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecione uma foto de boleto ou cupom para leitura.",
          "cameraPermission": "Permita a câmera para fotografar boletos e cupons fiscais.",
          "microphonePermission": "Permita o microfone para registrar lançamentos por voz."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
